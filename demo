<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PayPal - The way to send and receive money online</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <!-- Header Section -->
        <header class="header">
            <div class="logo-area">
                <img src="logo.png" alt="PayPal Logo" class="logo">
            </div>
            <div class="auth-links">
                <a href="#">Sign Up</a> | <a href="#">Log In</a> | <a href="#">Help</a>
            </div>
        </header>

        <!-- Navigation Menu -->
        <nav class="navbar">
            <ul>
                <li class="active"><a href="#">Welcome</a></li>
                <li><a href="#">Send Money</a></li>
                <li><a href="#">Request Money</a></li>
                <li><a href="#">Shop</a></li>
                <li><a href="#">Sell</a></li>
            </ul>
        </nav>

        <!-- Main Content Area -->
        <main class="main-content">
            <div class="left-column">
                <h2>The way to send and receive money online</h2>
                
                <div class="send-money-box">
                    <h3>Send Money</h3>
                    <p>Pay anyone with an email address</p>
                </div>

                <div class="request-money-box">
                    <h3>Request Money</h3>
                    <p>Send a personal or group bill</p>
                </div>

                <p class="members-text">Over 15 million members worldwide!</p>

                <div class="signup-banner">
                    <a href="#">Sign up for your FREE PayPal Account!</a>
                </div>
            </div>

            <div class="right-column">
                <div class="promo-bubble">
                    <p>Get $5 for signing up!</p>
                </div>
            </div>
        </main>

        <!-- Footer / Bottom Links -->
        <footer class="footer">
            <p><a href="#">About Us</a> | <a href="#">Accounts</a> | <a href="#">Fees</a> | <a href="#">Privacy</a> | <a href="#">Security Center</a></p>
            <p class="copyright">Copyright &copy; 2002 PayPal. All rights reserved.</p>
        </footer>
    </div>

</body>
</html>
