<!DOCTYPE html>
<html>
<head>
    <meta name="description" content="A fake personal website created for HTML practice.">
    <title>My First Fake Website</title>
</head>
<body>

    <!-- Main Title -->
    <h1>John Doe</h1>
    <p>Welcome to my fake website! I am learning how to code HTML.</p>

    <hr>

    <!-- Navigation Links -->
    <div>
        <p>
            <a href="#about">About Me</a> | 
            <a href="#skills">My Skills</a> | 
            <a href="#contact">Contact Me</a>
        </p>
    </div>

    <!-- About Me Section -->
    <div id="about">
        <h2>About Me</h2>
        <p>Bacon ipsum dolor amet turkey ham hock jerky. I love building websites and testing out <span>cool code ideas</span> in Silicon Valley!</p>
    </div>

    <!-- Skills List -->
    <div>
        <h2>My Hobbies & Skills</h2>
        <ul>
            <li>HTML Coding</li>
            <li>Web Design</li>
            <li>Playing Video Games</li>
        </ul>
    </div>

    <!-- Table Section -->
    <div id="skills">
        <h2>My Experience</h2>
        <table border="1">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Years</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Student Programmer</td>
                    <td>2023 - 2024</td>
                </tr>
                <tr>
                    <td>Junior Web Creator</td>
                    <td>2024 - Present</td>
                </tr>
            </tbody>
        </table>
    </div>

    <hr>

    <!-- Fake Contact Form Section -->
    <div id="contact">
        <h2>Contact Me</h2>
        
        <form>
            <!-- Text Input -->
            <p>Your Name:</p>
            <input type="text" name="username">

            <!-- Select Dropdown -->
            <p>Choose a Subject:</p>
            <select name="subject">
                <option value="general">General Question</option>
                <option value="job">Job Inquiry</option>
            </select>

            <!-- Radio Buttons -->
            <p>Preferred Contact Method:</p>
            <input type="radio" name="contact_method" value="email"> Email
            <input type="radio" name="contact_method" value="phone"> Phone

            <!-- Checkbox -->
            <p>Subscribe to Updates?</p>
            <input type="checkbox" name="newsletter"> Yes, sign me up!

            <br><br>

            <!-- Submit Button -->
            <input type="submit" value="Send Message">
        </form>
    </div>

</body>
</html>
