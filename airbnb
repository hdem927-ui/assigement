<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Sign in to Twitter</title>
    <style>
        /* Basic page setup */
        body {
            background-color: #242424;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        /* The white box (modal) in the center */
        .login-box {
            background-color: white;
            width: 400px;
            padding: 30px;
            border-radius: 15px;
            position: relative;
        }

        /* Close button */
        .close-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            position: absolute;
            top: 15px;
            left: 15px;
        }

        /* Twitter Bird Icon */
        .logo {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo svg {
            width: 30px;
            height: 30px;
            fill: #1d9bf0;
        }

        /* Title */
        h1 {
            text-align: center;
            font-size: 26px;
            margin-bottom: 25px;
        }

        /* Buttons (Google, Apple, Next, Forgot Password) */
        .btn {
            width: 100%;
            padding: 12px;
            border-radius: 30px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 12px;
            text-decoration: none;
        }

        .btn-light {
            background-color: white;
            border: 1px solid #ccc;
            color: black;
        }

        .btn-light:hover {
            background-color: #f5f5f5;
        }

        .btn-dark {
            background-color: black;
            color: white;
            border: none;
        }

        .btn-dark:hover {
            background-color: #333;
        }

        /* Divider ("or") */
        .divider {
            text-align: center;
            margin: 15px 0;
            color: #666;
            position: relative;
        }

        .divider hr {
            border: 0;
            border-top: 1px solid #ccc;
            margin-top: -10px;
        }

        .divider span {
            background-color: white;
            padding: 0 10px;
            position: relative;
        }

        /* Input text field */
        input[type="text"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 15px;
            margin-bottom: 15px;
            box-sizing: border-box;
        }

        input[type="text"]:focus {
            border-color: #1d9bf0;
            outline: none;
        }

        /* Footer sign up text */
        .footer-text {
            margin-top: 30px;
            font-size: 14px;
            color: #555;
        }

        .footer-text a {
            color: #1d9bf0;
            text-decoration: none;
        }

        .footer-text a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="login-box">
        
        <!-- Close Button -->
        <button class="close-btn">✕</button>

        <!-- Twitter Logo -->
        <div class="logo">
            <svg viewBox="0 0 24 24">
                <path d="M23.643 4.937c-.835.37-1.732.62-2.675.733.962-.576 1.7-1.49 2.048-2.578-.9.534-1.897.922-2.958 1.13-.85-.904-2.06-1.47-3.4-1.47-2.572 0-4.658 2.086-4.658 4.66 0 .364.042.718.12 1.06-3.873-.195-7.304-2.05-9.602-4.868-.4.69-.63 1.49-.63 2.342 0 1.616.823 3.043 2.072 3.878-.764-.025-1.482-.234-2.11-.583v.06c0 2.257 1.605 4.14 3.737 4.568-.392.106-.823.162-1.258.162-.307 0-.605-.03-.895-.086.605 1.89 2.368 3.268 4.45 3.305-1.595 1.25-3.604 1.995-5.786 1.995-.376 0-.747-.022-1.112-.065 2.062 1.323 4.51 2.093 7.14 2.093 8.57 0 13.255-7.098 13.255-13.254 0-.2-.005-.402-.014-.602.91-.658 1.7-1.477 2.323-2.41z"/>
            </svg>
        </div>

        <!-- Heading -->
        <h1>Sign in to Twitter</h1>

        <!-- Google Login Button -->
        <button class="btn btn-light">
            Sign in with Google
        </button>

        <!-- Apple Login Button -->
        <button class="btn btn-light">
            Sign in with Apple
        </button>

        <!-- Divider -->
        <div class="divider">
            <hr>
            <span>or</span>
        </div>

        <!-- Form with Input and Next Button -->
        <form>
            <input type="text" placeholder="Phone, email, or username" required>
            <button type="submit" class="btn btn-dark">Next</button>
        </form>

        <!-- Forgot Password Button -->
        <button class="btn btn-light">
            Forgot password?
        </button>

        <!-- Footer Sign Up Link -->
        <div class="footer-text">
            Don't have an account? <a href="#">Sign up</a>[cite: 2]
        </div>

    </div>

</body>
</html>
