<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>AirBed & Breakfast - Find a place to stay.</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Main 1000px Container -->
    <div class="container">
        
        <!-- Header -->
        <h1 class="main-heading">AirBed & Breakfast – Find a place to stay.</h1>
        
        <div class="top-links">
            <ul>
                <li><a href="#">Sign Up</a>[cite: 3]</li>
                <li><a href="#">Sign In</a>[cite: 3]</li>
            </ul>
        </div>

        <div class="notice-box">
            This listing is no longer available.
        </div>

        <!-- Content Area -->
        <div class="content-area">
            
            <!-- Left Side: Form -->
            <div class="left-box">
                <h2>Find a place to stay.</h2>
                <p class="sub-text">Rent nightly from real people in 830 cities in 73 countries.</p>

                <div class="form-row">
                    <label>Where are you going?</label><br>
                    <input type="text" class="text-input">
                </div>

                <div class="form-row">
                    <label>Check in</label><br>
                    <input type="text" class="text-input" value="mm/dd/yyyy">
                </div>

                <div class="form-row">
                    <label>Check out</label><br>
                    <input type="text" class="text-input" value="mm/dd/yyyy">
                </div>

                <div class="form-row">
                    <label>Guests</label><br>
                    <select class="select-input">
                        <option>1</option>
                        <option>2</option>
                        <option>3</option>
                        <option>4</option>
                    </select>
                </div>

                <div class="city-box">
                    <a href="#">San Francisco, CA</a>
                    <p>Rooms from $29/night</p>
                </div>
            </div>

            <!-- Right Side: Featured Pictures/Cards -->
            <div class="right-box">
                <div class="card">
                    <img src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=400&q=80" alt="Pool">
                    <p class="card-title"><a href="#">"Gabs place" - Amsterdam, Netherlands</a></p>
                    <p class="card-desc">$85/night<br>1 Review</p>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?auto=format&fit=crop&w=400&q=80" alt="House">
                    <p class="card-title">Frances & Greg, Los Angeles</p>
                    <p class="card-desc">Recently reviewed</p>
                </div>
            </div>

        </div>

        <!-- Footer -->
        <div class="footer">
            <p><strong>As seen on:</strong> CNN, The New York Times, TechCrunch, Newsweek</p>
            
            <div class="footer-columns">
                <ul>
                    <li><a href="#">About</a></li>
                    <li><a href="#">FAQ</a></li>
                    <li><a href="#">Contact</a></li>
                    <li><a href="#">Terms & Privacy</a></li>
                </ul>
                <ul>
                    <li>Biggest Deals: <a href="#">New York</a></li>
                    <li><a href="#">San Francisco</a></li>
                    <li><a href="#">Paris</a></li>
                </ul>
                <ul>
                    <li>Join us on: <a href="#">Twitter</a></li>
                    <li><a href="#">Facebook</a></li>
                </ul>
            </div>

            <p class="copy">© AirBed & Breakfast, Inc.</p>
        </div>

    </div>

</body>
</html>
