<!DOCTYPE html>
<html>
<head>
    <title>AirBed & Breakfast</title>
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body>

    <!-- Main wrapper box with a fixed width of 1000px -->
    <div id="wrapper">

        <!-- Top Header Part -->
        <h1>AirBed & Breakfast – Find a place to stay.</h1>
        
        <div class="top-links">
            <a href="#">Sign Up</a> | 
            <a href="#">Sign In</a>
        </div>

        <hr>

        <!-- Main Content Area -->
        <div class="main-content">

            <!-- Left Box: Search Form -->
            <div class="left-box">
                <h2>Find a place to stay.</h2>
                <p><a href="#">Rent nightly from real people in 830 cities in 73 countries.</a></p>

                <form>
                    <p>Where are you going?</p>
                    <input type="text" value="San Francisco, CA">

                    <p>Check in</p>
                    <input type="text" value="mm/dd/yyyy">

                    <p>Check out</p>
                    <input type="text" value="mm/dd/yyyy">

                    <p>Guests</p>
                    <select>
                        <option>1</option>
                    </select>
                </form>
            </div>

            <!-- Right Box: Picture & Listings -->
            <div class="right-box">
                <img src="pool-house.jpg" width="400" alt="Pool house">
                <p>"Gabs place" - Amsterdam, Netherlands</p>
                <p>$85/night</p>
                <p>1 Review</p>
            </div>

        </div>

        <!-- Footer Links -->
        <div class="footer">
            <p>As seen on: CNN, The New York Times, TechCrunch</p>
            <ul>
                <li><a href="#">About</a></li>
                <li><a href="#">FAQ</a></li>
                <li><a href="#">Contact</a></li>
                <li><a href="#">Terms & Privacy</a></li>
            </ul>
        </div>

    </div>

</body>
</html>
