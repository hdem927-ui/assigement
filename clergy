<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>craigslist: san francisco bay area</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="main-container">
        
        <!-- Header Section -->
        <div class="header">
            <span class="logo">craigslist</span>
            <span class="location">san francisco bay area</span>
            <div class="other-city">
                other craigslist: <select><option>select city</option></select> <button>go</button>
            </div>
        </div>

        <!-- Columns Container -->
        <div class="columns-box">
            
            <!-- Column 1 -->
            <div class="col col-1">
                <ul>
                    <li><a href="#">help?</a></li>
                    <li><a href="#">post a listing</a></li>
                </ul>
                
                <div class="category-title">FAQ subscriptions</div>
                
                <div class="search-box">
                    <b>search craigslist</b><br>
                    <select><option>community</option></select><br>
                    <input type="text"><br>
                    <button>search</button>
                </div>

                <ul>
                    <li><a href="#">feedback</a></li>
                    <li><a href="#">our policies</a></li>
                    <li><a href="#">about craigslist</a></li>
                    <li><a href="#">questions@craigslist.org</a></li>
                </ul>

                <p class="date">updated 14 June 2000[cite: 7, 8]</p>
            </div>

            <!-- Column 2 -->
            <div class="col col-2">
                <div class="category-title">community & events</div>
                <ul>
                    <li><a href="#">events / entertainment</a></li>
                    <li><a href="#">tech events</a></li>
                    <li><a href="#">classes / workshops</a></li>
                    <li><a href="#">artists / musicians</a></li>
                    <li><a href="#">community</a></li>
                    <li><a href="#">pets / animals</a></li>
                    <li><a href="#">volunteers</a></li>
                    <li><a href="#">review / recommend</a></li>
                </ul>

                <div class="category-title">personals</div>
                <ul>
                    <li><a href="#">women for women</a></li>
                    <li><a href="#">women for men</a></li>
                    <li><a href="#">men for women</a></li>
                    <li><a href="#">men for men</a></li>
                    <li><a href="#">misc romance</a></li>
                </ul>

                <ul>
                    <li><a href="#">activity partners</a></li>
                    <li><a href="#">carpool / rideshare</a></li>
                </ul>

                <div class="category-title">discussion boards</div>
            </div>

            <!-- Column 3 -->
            <div class="col col-3">
                <div class="category-title">housing</div>
                <ul>
                    <li><a href="#">apts / housing</a></li>
                    <li><a href="#">apts / housing wanted</a></li>
                    <li><a href="#">rooms / shared</a></li>
                    <li><a href="#">rooms / shared wanted</a></li>
                    <li><a href="#">sublets / temporary / vac</a></li>
                    <li><a href="#">office / commercial</a></li>
                    <li><a href="#">parking / storage</a></li>
                </ul>

                <div class="category-title">sale / wanted</div>
                <ul>
                    <li><a href="#">barter / swap / free</a></li>
                    <li><a href="#">bikes / cycles / scooters</a></li>
                    <li><a href="#">cars / trucks</a></li>
                    <li><a href="#">computer / tech stuff</a></li>
                    <li><a href="#">general for sale</a></li>
                    <li><a href="#">items wanted</a></li>
                    <li><a href="#">small biz ads</a></li>
                    <li><a href="#">tickets</a></li>
                </ul>

                <div class="category-title">resumes</div>
                <ul>
                    <li><a href="#">freelance services 1099</a></li>
                </ul>
            </div>

            <!-- Column 4 -->
            <div class="col col-4">
                <div class="category-title">jobs</div>
                <ul>
                    <li><a href="#">accounting / finance</a></li>
                    <li><a href="#">admin / customer service</a></li>
                    <li><a href="#">architect / engineer / CAD</a></li>
                    <li><a href="#">arts / print / design</a></li>
                    <li><a href="#">business / e-biz / mgmt</a></li>
                    <li><a href="#">human resources</a></li>
                    <li><a href="#">internet / web engineering</a></li>
                    <li><a href="#">legal / paralegal</a></li>
                    <li><a href="#">marketing / advertising / pr</a></li>
                    <li><a href="#">medical / health / biotech</a></li>
                    <li><a href="#">network / telecomm / WAN</a></li>
                    <li><a href="#">nonprofit sector</a></li>
                    <li><a href="#">retail / hospitality / food</a></li>
                    <li><a href="#">sales / biz dev</a></li>
                    <li><a href="#">software / QA / DBA / etc</a></li>
                    <li><a href="#">system administration</a></li>
                    <li><a href="#">технический support</a></li>
                    <li><a href="#">tv / film / video / radio</a></li>
                    <li><a href="#">web / info design</a></li>
                    <li><a href="#">writing / editing</a></li>
                    <li><a href="#">et cetera</a></li>
                </ul>
            </div>

        </div>

    </div>

</body>
</html>
