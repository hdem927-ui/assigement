<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>X / Twitter - Login</title>
    <!-- Tailwind CSS CDN for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #000000;
            color: #e7e9ea;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Main Container -->
    <div class="flex flex-col lg:flex-row flex-grow items-center justify-center lg:justify-between w-full max-w-7xl mx-auto px-4 py-8 lg:px-12">
        
        <!-- Left Column: Branding / Logo -->
        <div class="flex items-center justify-center lg:justify-start w-full lg:w-1/2 mb-10 lg:mb-0">
            <!-- Twitter/X SVG Logo -->
            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-24 h-24 lg:w-96 lg:h-96 fill-white">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
        </div>

        <!-- Right Column: Login & Actions -->
        <div class="flex flex-col w-full lg:w-1/2 max-w-md lg:max-w-lg space-y-8">
            <!-- Header Text -->
            <div>
                <h1 class="text-4xl lg:text-6xl font-extrabold tracking-tight mb-8">Happening now</h1>
                <h2 class="text-2xl lg:text-3xl font-bold mb-6">Join today.</h2>
            </div>

            <!-- Auth Buttons -->
            <div class="flex flex-col space-y-3 w-full max-w-xs">
                <!-- Sign up with Google -->
                <button onclick="showAlert('Google Sign Up clicked!')" class="flex items-center justify-center bg-white text-black font-semibold rounded-full py-2.5 px-4 hover:bg-gray-200 transition duration-200">
                    <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.13 0-5.78-2.11-6.73-4.96H1.18v3.15C3.15 21.32 7.22 24 12 24z"/>
                        <path fill="#FBBC05" d="M5.27 14.24c-.25-.72-.38-1.49-.38-2.24s.13-1.52.38-2.24V6.6H1.18C.43 8.1 0 9.98 0 12s.43 3.9 1.18 5.4l4.09-3.16z"/>
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.22 0 3.15 2.68 1.18 6.6l4.09 3.15c.95-2.85 3.6-4.96 6.73-4.96z"/>
                    </svg>
                    Sign up with Google
                </button>

                <!-- Sign up with Apple -->
                <button onclick="showAlert('Apple Sign Up clicked!')" class="flex items-center justify-center bg-white text-black font-semibold rounded-full py-2.5 px-4 hover:bg-gray-200 transition duration-200">
                    <svg class="w-5 h-5 mr-2 fill-current" viewBox="0 0 24 24">
                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.83 5.37c.56-.68.94-1.63.84-2.58-.84.04-1.85.56-2.44 1.24-.52.59-.98 1.55-.86 2.48.94.07 1.9-.5 2.46-1.14z"/>
                    </svg>
                    Sign up with Apple
                </button>

                <!-- Divider -->
                <div class="flex items-center my-2">
                    <div class="flex-grow border-t border-gray-800"></div>
                    <span class="px-3 text-gray-500 text-sm">or</span>
                    <div class="flex-grow border-t border-gray-800"></div>
                </div>

                <!-- Create Account Button -->
                <button onclick="openModal('signup')" class="bg-[#1d9bf0] hover:bg-[#1a8cd8] text-white font-semibold rounded-full py-2.5 px-4 transition duration-200">
                    Create account
                </button>

                <!-- Terms -->
                <p class="text-[11px] text-gray-500 leading-tight mt-1">
                    By signing up, you agree to the <a href="#" class="text-[#1d9bf0] hover:underline">Terms of Service</a> and <a href="#" class="text-[#1d9bf0] hover:underline">Privacy Policy</a>, including <a href="#" class="text-[#1d9bf0] hover:underline">Cookie Use</a>.
                </p>
            </div>

            <!-- Login Section -->
            <div class="mt-10 max-w-xs">
                <h3 class="font-bold text-lg mb-4">Already have an account?</h3>
                <button onclick="openModal('login')" class="w-full border border-gray-700 hover:border-gray-600 hover:bg-[#1d9bf0]/10 text-[#1d9bf0] font-semibold rounded-full py-2.5 px-4 transition duration-200">
                    Sign in
                </button>
            </div>
        </div>
    </div>

    <!-- Footer Links -->
    <footer class="w-full py-6 text-center text-xs text-gray-500 px-4">
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 mb-2">
            <a href="#" class="hover:underline">About</a>
            <a href="#" class="hover:underline">Download the X app</a>
            <a href="#" class="hover:underline">Help Center</a>
            <a href="#" class="hover:underline">Terms of Service</a>
            <a href="#" class="hover:underline">Privacy Policy</a>
            <a href="#" class="hover:underline">Cookie Policy</a>
            <a href="#" class="hover:underline">Accessibility</a>
            <a href="#" class="hover:underline">Ads info</a>
            <a href="#" class="hover:underline">Blog</a>
            <a href="#" class="hover:underline">Careers</a>
            <a href="#" class="hover:underline">Brand Resources</a>
            <a href="#" class="hover:underline">Advertising</a>
            <a href="#" class="hover:underline">Marketing</a>
            <a href="#" class="hover:underline">X for Business</a>
            <a href="#" class="hover:underline">Developers</a>
            <a href="#" class="hover:underline">Directory</a>
            <a href="#" class="hover:underline">Settings</a>
        </div>
        <p>© 2026 X Corp.</p>
    </footer>

    <!-- Simple Popup Modal (Hidden by default) -->
    <div id="authModal" class="fixed inset-0 bg-black bg-y-50 bg-opacity-70 hidden items-center justify-center z-50">
        <div class="bg-black border border-gray-800 rounded-2xl w-full max-w-md p-6 relative">
            <button onclick="closeModal()" class="absolute top-4 left-4 text-gray-400 hover:text-white">
                ✕
            </button>
            <div class="flex justify-center mb-6">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="w-8 h-8 fill-white">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
            </div>
            <h2 id="modalTitle" class="text-xl font-bold mb-4 text-center">Sign in to X</h2>
            <form onsubmit="handleFormSubmit(event)" class="space-y-4">
                <input type="text" placeholder="Phone, email, or username" required class="w-full bg-black border border-gray-700 rounded p-3 text-white focus:border-[#1d9bf0] focus:outline-none">
                <input type="password" placeholder="Password" required class="w-full bg-black border border-gray-700 rounded p-3 text-white focus:border-[#1d9bf0] focus:outline-none">
                <button type="submit" class="w-full bg-white text-black font-bold rounded-full py-3 hover:bg-gray-200 transition">Next</button>
            </form>
        </div>
    </div>

    <!-- JavaScript for Modals & Interactivity -->
    <script>
        function showAlert(message) {
            alert(message);
        }

        function openModal(type) {
            const modal = document.getElementById('authModal');
            const title = document.getElementById('modalTitle');
            title.innerText = type === 'login' ? 'Sign in to X' : 'Create your X account';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('authModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            alert('Submitted successfully!');
            closeModal();
        }
    </script>
</body>
</html>
