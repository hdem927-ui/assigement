/* General reset */
* {
    margin: 5px;
    padding: 5px;
}

/* Outer silver container */
#container {
    width: 950px;
    background-color: silver;
    margin: 0 auto;
}

/* Blue top banner */
#header {
    height: 150px;
    background-color: blue;
}

/* Red sidebar */
#nav_bar {
    height: 300px;
    width: 180px;
    background-color: red; 
    display: inline-block;
    vertical-align: top;
}

/* Yellow main container */
#main_content {
    height: 360px;
    width: 700px;
    background-color: yellow; 
    display: inline-block;
    vertical-align: top;
}

/* Three purple boxes inside main content */
.subcontent {
    height: 200px;
    width: 180px;
    background-color: purple;
    display: inline-block;
}

/* Pink advertisement bar */
#advertisements {
    height: 90px;
    width: 650px;
    background-color: pink;
}
